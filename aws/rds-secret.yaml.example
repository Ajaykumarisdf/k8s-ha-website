# AWS RDS MySQL Connection Secret Template
# Copy this file to aws/rds-secret.yaml and fill in your actual credentials.
# Do NOT commit aws/rds-secret.yaml with real credentials to Git!
---
apiVersion: v1
kind: Secret
metadata:
  name: rds-secret
type: Opaque
stringData:
  # RDS Endpoint (e.g., database-1.xxxxxx.us-east-1.rds.amazonaws.com)
  rds-endpoint: "your-rds-endpoint.us-east-1.rds.amazonaws.com"

  # Database port
  rds-port: "3306"

  # Database name
  rds-database: "guestbook"

  # Database user
  rds-user: "admin"

  # Database password
  rds-password: "YOUR_RDS_PASSWORD"
